{
    "name": "eventfinder/eventfinder",
    "type": "project",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Test\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Eugene Zarianski"
        }
    ],
    "require": {
        "nikic/fast-route": "^1.3",
        "php-di/php-di": "^7.1",
        "elasticsearch/elasticsearch": "^9.5",
        "mongodb/mongodb": "^2.5",
        "vlucas/phpdotenv": "^5.8"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "guzzlehttp/guzzle": "^8.3"
    }
}
